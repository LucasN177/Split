@* Platzhalter für leere Listen *@
<MudStack AlignItems="AlignItems.Center" Class="py-10 px-4" Spacing="2">
    <MudIcon Icon="@Icon" Color="Color.Primary" Style="font-size: 3.5rem; opacity: 0.8;" />
    <MudText Typo="Typo.h6" Align="Align.Center">@Title</MudText>
    @if (!string.IsNullOrEmpty(Description))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">@Description</MudText>
    }
    @ChildContent
</MudStack>

@code {
    [Parameter] public string Icon { get; set; } = Icons.Material.Outlined.Inbox;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
