@implements IDisposable
@inject IGroupService GroupService

<MudNavMenu Color="Color.Primary" Bordered="true" Class="pt-2">

    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-4 mt-2 mb-1 d-block">
        Übersicht
    </MudText>

    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>
    <MudNavLink Href="groups" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Groups">
        Alle Gruppen
    </MudNavLink>

    <MudDivider Class="my-3"/>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-4 mb-1 d-block">
        Meine Gruppen
    </MudText>

    @foreach (var group in GroupService.Groups.Take(10))
    {
        <MudNavLink Href="@($"groups/{group.Id}")" Icon="@Icons.Material.Outlined.Group">
            <span class="text-truncate d-block">@group.Name</span>
        </MudNavLink>
    }
    @if (GroupService.Groups.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="px-4 py-2">Noch keine Gruppen</MudText>
    }

    <MudDivider Class="my-3"/>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-4 mb-1 d-block">
        System
    </MudText>
    <MudNavLink Href="settings" Icon="@Icons.Material.Filled.Settings">
        Einstellungen
    </MudNavLink>

</MudNavMenu>

@code {
    protected override void OnInitialized() => GroupService.GroupsChanged += OnGroupsChanged;

    private void OnGroupsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => GroupService.GroupsChanged -= OnGroupsChanged;
}
