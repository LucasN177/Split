@inherits LayoutComponentBase
@inject AppStateService AppStateService

@* Layout für Anmeldung und Registrierung – ohne Navigation *@
<div class="auth-wrapper">
    <div class="auth-card">
        <MudStack AlignItems="AlignItems.Center" Spacing="0" Class="mb-6">
            <MudText Typo="Typo.h3" Style="font-weight: 800; letter-spacing: -0.04em;">
                <span style="color: var(--mud-palette-primary)">Sp</span>lit
            </MudText>
            <MudText Class="mud-text-secondary" Typo="Typo.body2">Gemeinsame Ausgaben, fair geteilt</MudText>
        </MudStack>

        <MudPaper Elevation="3" Class="pa-6 pa-sm-8">
            @Body
        </MudPaper>

        <MudStack Row="true" Justify="Justify.Center" Class="mt-4">
            <MudIconButton Icon="@(AppStateService.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Size="Size.Small"
                           aria-label="Farbschema wechseln"
                           OnClick="@AppStateService.ToggleDarkMode" />
        </MudStack>
    </div>
</div>
