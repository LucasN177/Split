@inherits LayoutComponentBase
@implements IDisposable
@inject AppStateService AppStateService
@inject IAuthService AuthService
@inject IGroupService GroupService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

@if (!AuthService.IsAuthenticated)
{
    <RedirectToLogin />
}
else
{
    <MudLayout>
        <MudAppBar Elevation="1" Fixed="true" Dense="false">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           aria-label="Menü"
                           OnClick="@AppStateService.DrawerToggle" />

            <MudLink Href="" Underline="Underline.None" Color="Color.Inherit">
                <MudStack Row="false" Spacing="0">
                    <MudText Typo="Typo.h5" Class="mr-6" Style="margin-bottom: 0; font-weight: 800; letter-spacing: -0.03em;">
                        <span style="color: var(--mud-palette-primary)">Sp</span>lit
                    </MudText>
                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin-top: -4px">By Lucas Nagelsmann</MudText>
                    </MudHidden>
                </MudStack>
            </MudLink>

            <MudSpacer />

            <MudTooltip Text="@(AppStateService.IsDarkMode ? "Heller Modus" : "Dunkler Modus")">
                <MudIconButton Icon="@(AppStateService.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit"
                               aria-label="Farbschema wechseln"
                               OnClick="@AppStateService.ToggleDarkMode" />
            </MudTooltip>

            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-1">
                <ActivatorContent>
                    <MudAvatar Color="Color.Primary" Size="Size.Medium" Style="cursor: pointer;">@Money.Initials(DisplayName)</MudAvatar>
                </ActivatorContent>
                <ChildContent>
                    <div class="px-4 py-2">
                        <MudText Typo="Typo.subtitle2">@DisplayName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@AuthService.CurrentUser?.Email</MudText>
                    </div>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Person" Href="settings">Profil & Einstellungen</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="Logout">Abmelden</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </MudAppBar>

        <MudDrawer @bind-Open="AppStateService.IsDrawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="@DrawerVariant.Responsive"
                   OpenMiniOnHover="false">
            <NavMenu/>
            <MudSpacer/>
            <div class="pa-4">
                <MudDivider Class="mb-4"/>
                <MudText Color="Color.Secondary" Typo="Typo.caption" Align="Align.Center" Class="d-block">
                    Split v@(Version)
                </MudText>
                <MudText Color="Color.Secondary" Typo="Typo.caption" Align="Align.Center" Class="d-block">
                    © 2026
                </MudText>
            </div>
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Large" Class="split-page">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

@code
{
    private static readonly string Version = typeof(MainLayout).Assembly.GetName().Version?.ToString(2) ?? "1.0";

    private string DisplayName
    {
        get
        {
            var profile = AuthService.CurrentProfile;
            var fullName = $"{profile?.Vorname} {profile?.Nachname}".Trim();
            if (!string.IsNullOrEmpty(fullName)) return fullName;
            if (!string.IsNullOrEmpty(profile?.Username)) return profile.Username;
            return AuthService.CurrentUser?.Email ?? "Benutzer";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthStateChanged += OnStateChanged;

        if (AuthService.IsAuthenticated && GroupService.Groups.Count == 0)
        {
            var result = await GroupService.LoadGroups();
            if (!result.IsSuccess)
                Snackbar.Add($"Gruppen konnten nicht geladen werden: {result.ErrorMessage}", Severity.Warning);
        }
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private async Task Logout()
    {
        await AuthService.Logout();
        Snackbar.Add("Du wurdest abgemeldet.", Severity.Info);
        Navigation.NavigateTo("login", replace: true);
    }

    public void Dispose() => AuthService.AuthStateChanged -= OnStateChanged;
}
