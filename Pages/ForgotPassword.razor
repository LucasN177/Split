@page "/forgot-password"
@layout AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Passwort vergessen – Split</PageTitle>

@if (_sent)
{
    <EmptyState Icon="@Icons.Material.Outlined.MarkEmailRead" Title="E-Mail gesendet"
                Description="Falls ein Konto mit dieser Adresse existiert, erhältst du in Kürze einen Link zum Zurücksetzen.">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="login" Class="mt-2">Zur Anmeldung</MudButton>
    </EmptyState>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-1">Passwort vergessen</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">Wir senden dir einen Link zum Zurücksetzen.</MudText>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
    }

    <MudTextField @bind-Value="_email" Label="E-Mail" Variant="Variant.Outlined" InputType="InputType.Email" AutoFocus="true" />

    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="mt-6"
               Disabled="@(_busy || string.IsNullOrWhiteSpace(_email))" OnClick="Submit">
        Link senden
    </MudButton>

    <MudText Align="Align.Center" Typo="Typo.body2" Class="mt-6">
        <MudLink Href="login">Zurück zur Anmeldung</MudLink>
    </MudText>
}

@code {
    private string _email = string.Empty;
    private bool _busy;
    private bool _sent;
    private string? _error;

    private async Task Submit()
    {
        _busy = true;
        _error = null;
        var result = await AuthService.ResetPassword(_email, Navigation.BaseUri + "reset-password");
        _busy = false;

        if (result.IsSuccess)
            _sent = true;
        else
            _error = result.ErrorMessage;
    }
}
