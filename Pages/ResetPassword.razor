@page "/reset-password"
@layout AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Neues Passwort – Split</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <EmptyState Icon="@Icons.Material.Outlined.LinkOff" Title="Link abgelaufen"
                Description="Der Link zum Zurücksetzen ist ungültig oder abgelaufen. Fordere einfach einen neuen an.">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="forgot-password" Class="mt-2">Neuen Link anfordern</MudButton>
    </EmptyState>
}
else
{
    <MudText Typo="Typo.h5" Class="mb-1">Neues Passwort festlegen</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">Für @AuthService.CurrentUser?.Email</MudText>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
    }

    <MudTextField @bind-Value="_password" Label="Neues Passwort" Variant="Variant.Outlined" InputType="InputType.Password"
                  Immediate="true" HelperText="Mindestens 8 Zeichen" AutoFocus="true" Class="mb-3" />
    <MudTextField @bind-Value="_repeat" Label="Passwort wiederholen" Variant="Variant.Outlined" InputType="InputType.Password"
                  Immediate="true" Error="@(_repeat.Length > 0 && _repeat != _password)" ErrorText="Passwörter stimmen nicht überein" />

    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Size="Size.Large" Class="mt-6"
               Disabled="@(_busy || _password.Length < 8 || _password != _repeat)" OnClick="Submit">
        Passwort speichern
    </MudButton>
}

@code {
    private string _password = string.Empty;
    private string _repeat = string.Empty;
    private bool _busy;
    private string? _error;

    private async Task Submit()
    {
        _busy = true;
        _error = null;
        var result = await AuthService.UpdatePassword(_password);
        _busy = false;

        if (!result.IsSuccess)
        {
            _error = result.ErrorMessage;
            return;
        }

        Snackbar.Add("Passwort geändert.", Severity.Success);
        Navigation.NavigateTo("", replace: true);
    }
}
