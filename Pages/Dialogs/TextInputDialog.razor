@* Einfacher Dialog zur Eingabe eines Textes (z.B. Umbenennen) *@
<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_value" Label="@Label" Variant="Variant.Outlined" AutoFocus="true" Immediate="true"
                      MaxLength="@MaxLength" OnKeyDown="OnKeyDown" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Abbrechen</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@string.IsNullOrWhiteSpace(_value)" OnClick="Submit">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string Label { get; set; } = "Name";
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string ConfirmText { get; set; } = "Speichern";
    [Parameter] public int MaxLength { get; set; } = 80;

    private string _value = string.Empty;

    protected override void OnInitialized() => _value = Value;

    private void OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_value))
            Submit();
    }

    private void Submit() => MudDialog.Close(DialogResult.Ok(_value.Trim()));
}
