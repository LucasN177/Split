@page "/groups/{GroupId}"
@using System.Text
@implements IAsyncDisposable
@inject IGroupService GroupService
@inject IExpenseService ExpenseService
@inject IAuthService AuthService
@inject RealtimeService Realtime
@inject OfflineSyncService OfflineSync
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_details?.Group.Name ?? "Gruppe") – Split</PageTitle>

@if (_loading && _details is null)
{
    <PageLoader Text="Gruppe wird geladen …" />
}
else if (_details is null)
{
    <EmptyState Icon="@Icons.Material.Outlined.ErrorOutline" Title="Gruppe nicht verfügbar" Description="@_error">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="groups" Class="mt-2">Zu den Gruppen</MudButton>
    </EmptyState>
}
else
{
    var currency = _details.Group.Currency;

    <MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Style="min-width: 0;">
            <MudAvatar Color="Color.Primary" Size="Size.Large">@Money.Initials(_details.Group.Name)</MudAvatar>
            <div style="min-width: 0;">
                <MudText Typo="Typo.h4" Class="text-truncate">@_details.Group.Name</MudText>
                @if (!string.IsNullOrWhiteSpace(_details.Group.Description))
                {
                    <MudText Class="mud-text-secondary" Typo="Typo.body2">@_details.Group.Description</MudText>
                }
            </div>
        </MudStack>
        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
            @if (_loading)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" Class="mr-2" />
            }
            <MudTooltip Text="Freunde einladen">
                <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" aria-label="Freunde einladen"
                               Disabled="_details.IsFromCache" OnClick="Invite" />
            </MudTooltip>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Gruppenaktionen">
                <MudMenuItem Icon="@Icons.Material.Filled.Refresh" OnClick="Load">Aktualisieren</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Edit" Disabled="_details.IsFromCache" OnClick="EditGroup">Bearbeiten</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Download" OnClick="ExportCsv">Als CSV exportieren</MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.ExitToApp" Disabled="_details.IsFromCache" OnClick="LeaveGroup">Gruppe verlassen</MudMenuItem>
                @if (_details.IsAdmin)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" Disabled="_details.IsFromCache" OnClick="DeleteGroup">Gruppe löschen</MudMenuItem>
                }
            </MudMenu>
        </MudStack>
    </MudStack>

    @if (_details.IsFromCache)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4" Icon="@Icons.Material.Filled.CloudOff">
            Offline – Stand vom @_details.LoadedAt.ToString("dd.MM.yyyy HH:mm"). Neue Ausgaben werden gespeichert, sobald du wieder online bist.
        </MudAlert>
    }
    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="6" sm="4">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Class="mud-text-secondary" Typo="Typo.caption">Gesamtausgaben</MudText>
                <MoneyText Amount="_details.TotalExpenses" Currency="@currency" Typo="Typo.h6" Colored="false" />
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Class="mud-text-secondary" Typo="Typo.caption">Dein Saldo</MudText>
                <MoneyText Amount="MyBalance" Currency="@currency" Typo="Typo.h6" ShowSign="true" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Elevation="1" Class="pa-4">
                <MudText Class="mud-text-secondary" Typo="Typo.caption">Mitglieder</MudText>
                <MudAvatarGroup Max="6" Spacing="2" MaxColor="Color.Primary" Class="mt-1">
                    @foreach (var member in _details.Members)
                    {
                        <MudTooltip Text="@member.DisplayName">
                            <MudAvatar Size="Size.Small" Color="@(member.UserId is null ? Color.Default : Color.Primary)">@Money.Initials(member.DisplayName)</MudAvatar>
                        </MudTooltip>
                    }
                </MudAvatarGroup>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pt-2" @bind-ActivePanelIndex="_tab">
        @* ---------------- Ausgaben ---------------- *@
        <MudTabPanel Text="Ausgaben" Icon="@Icons.Material.Filled.Receipt" BadgeData="@(_details.Expenses.Count > 0 ? _details.Expenses.Count : null)" BadgeColor="Color.Primary">
            @if (_details.Expenses.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.ReceiptLong" Title="Noch keine Ausgaben"
                            Description="Erfasse die erste Ausgabe – Split rechnet automatisch aus, wer wem was schuldet.">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenExpense(null)" Class="mt-2">
                        Ausgabe hinzufügen
                    </MudButton>
                </EmptyState>
            }
            else
            {
                <MudGrid Spacing="2" Class="mb-2 mt-1">
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="_search" Placeholder="Suchen (Titel, Notiz)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudSelect T="string" @bind-Value="_categoryFilter" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Kategorie" Clearable="true">
                            @foreach (var category in _details.Expenses.Select(e => e.Category).Distinct().Order())
                            {
                                <MudSelectItem Value="@category">@category</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudSelect T="string" @bind-Value="_memberFilter" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Mitglied" Clearable="true">
                            @foreach (var member in _details.Members)
                            {
                                <MudSelectItem Value="@member.Id">@member.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                @if (!FilteredExpenses.Any())
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary pa-4">Keine Ausgaben passend zum Filter.</MudText>
                }
                else
                {
                    @if (IsFiltered)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">
                            @FilteredExpenses.Count() Treffer · @Money.Format(FilteredExpenses.Sum(e => e.Amount), currency)
                        </MudText>
                    }
                    <MudPaper Elevation="0" Outlined="true">
                        @foreach (var month in FilteredExpenses.GroupBy(e => new DateTime(e.ExpenseDate.Year, e.ExpenseDate.Month, 1)))
                        {
                            <MudText Typo="Typo.overline" Class="mud-text-secondary px-4 pt-3 d-block">
                                @month.Key.ToString("MMMM yyyy", Money.Culture)
                            </MudText>
                            @foreach (var expense in month)
                            {
                                var myShare = MyShare(expense);
                                <div class="split-row split-card-link" @onclick="() => OpenExpense(expense)">
                                    <MudAvatar Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium">
                                        <MudIcon Icon="@Money.CategoryIcon(expense.Category)" />
                                    </MudAvatar>
                                    <div class="split-row-main">
                                        <MudText Typo="Typo.subtitle1" Class="text-truncate">
                                            @expense.Title
                                            @if (expense.RecurringId is not null)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Repeat" Size="Size.Small" Class="ml-1 mud-text-secondary" Style="vertical-align: middle;" />
                                            }
                                            @if (!string.IsNullOrEmpty(expense.ReceiptPath))
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" Class="ml-1 mud-text-secondary" Style="vertical-align: middle;" />
                                            }
                                        </MudText>
                                        <MudText Class="mud-text-secondary text-truncate d-block" Typo="Typo.caption">
                                            @_details.MemberName(expense.PaidBy) hat bezahlt · @expense.ExpenseDate.ToString("dd.MM.yyyy")
                                            @if (!string.IsNullOrWhiteSpace(expense.Note))
                                            {
                                                <span> · @expense.Note</span>
                                            }
                                        </MudText>
                                    </div>
                                    <div style="text-align: right;">
                                        <MoneyText Amount="expense.Amount" Currency="@currency" Colored="false" Typo="Typo.subtitle1" />
                                        @if (expense.IsForeignCurrency)
                                        {
                                            <MudText Class="mud-text-secondary" Typo="Typo.caption">@Money.Format(expense.OriginalAmount!.Value, expense.OriginalCurrency!)</MudText>
                                        }
                                        else if (myShare is not null)
                                        {
                                            <MudText Class="mud-text-secondary" Typo="Typo.caption">dein Anteil @Money.Format(myShare.Value, currency)</MudText>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </MudPaper>
                }
            }
        </MudTabPanel>

        @* ---------------- Salden ---------------- *@
        <MudTabPanel Text="Salden" Icon="@Icons.Material.Filled.AccountBalanceWallet">
            <MudPaper Elevation="0" Outlined="true" Class="mt-1">
                @{
                    var max = Math.Max(1m, _details.Balances.Select(b => Math.Abs(b.Balance)).DefaultIfEmpty(0).Max());
                }
                @foreach (var balance in _details.Balances)
                {
                    <div class="split-row">
                        <MudAvatar Size="Size.Small" Color="@(balance.Balance >= 0 ? Color.Success : Color.Error)" Variant="Variant.Outlined">
                            @Money.Initials(balance.DisplayName)
                        </MudAvatar>
                        <div class="split-row-main">
                            <MudText Typo="Typo.body1" Class="text-truncate">@balance.DisplayName</MudText>
                            <MudText Class="mud-text-secondary" Typo="Typo.caption">
                                bezahlt @Money.Format(balance.Paid, currency) · Anteil @Money.Format(balance.Owed, currency)
                            </MudText>
                            <MudProgressLinear Value="@((double)(Math.Abs(balance.Balance) / max * 100))" Rounded="true" Size="Size.Small"
                                               Color="@(balance.Balance >= 0 ? Color.Success : Color.Error)" Class="mt-1" />
                        </div>
                        <MoneyText Amount="balance.Balance" Currency="@currency" ShowSign="true" Typo="Typo.subtitle1" />
                    </div>
                }
            </MudPaper>
        </MudTabPanel>

        @* ---------------- Ausgleich ---------------- *@
        <MudTabPanel Text="Ausgleich" Icon="@Icons.Material.Filled.SwapHoriz" BadgeData="@(_details.Suggestions.Count > 0 ? _details.Suggestions.Count : null)" BadgeColor="Color.Warning">
            <MudText Typo="Typo.h6" Class="mb-2 mt-2">Vorgeschlagene Zahlungen</MudText>
            @if (_details.Suggestions.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">Alles ausgeglichen – niemand schuldet etwas. 🎉</MudAlert>
            }
            else
            {
                <MudPaper Elevation="0" Outlined="true" Class="mb-4">
                    @foreach (var suggestion in _details.Suggestions)
                    {
                        <div class="split-row">
                            <div class="split-row-main">
                                <MudText Typo="Typo.body1">
                                    <b>@suggestion.FromName</b>
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Style="vertical-align: middle;" Class="mx-1" />
                                    <b>@suggestion.ToName</b>
                                </MudText>
                            </div>
                            <MoneyText Amount="suggestion.Amount" Currency="@currency" Colored="false" Typo="Typo.subtitle1" />
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => OpenSettlement(null, suggestion)">
                                Begleichen
                            </MudButton>
                        </div>
                    }
                </MudPaper>
            }

            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudText Typo="Typo.h6">Erfasste Zahlungen</MudText>
                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary"
                           Disabled="@(_details.Members.Count < 2)" OnClick="() => OpenSettlement(null, null)">Zahlung erfassen</MudButton>
            </MudStack>
            @if (_details.Settlements.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">Noch keine Ausgleichszahlungen erfasst.</MudText>
            }
            else
            {
                <MudPaper Elevation="0" Outlined="true">
                    @foreach (var settlement in _details.Settlements)
                    {
                        <div class="split-row split-card-link" @onclick="() => OpenSettlement(settlement, null)">
                            <MudIcon Icon="@Icons.Material.Filled.Payments" Color="Color.Success" />
                            <div class="split-row-main">
                                <MudText Typo="Typo.body1" Class="text-truncate">
                                    @_details.MemberName(settlement.FromMember) → @_details.MemberName(settlement.ToMember)
                                </MudText>
                                <MudText Class="mud-text-secondary" Typo="Typo.caption">
                                    @settlement.SettledAt.ToString("dd.MM.yyyy")@(string.IsNullOrWhiteSpace(settlement.Note) ? "" : $" · {settlement.Note}")
                                </MudText>
                            </div>
                            <MoneyText Amount="settlement.Amount" Currency="@currency" Colored="false" />
                        </div>
                    }
                </MudPaper>
            }
        </MudTabPanel>

        @* ---------------- Wiederkehrend ---------------- *@
        <MudTabPanel Text="Wiederkehrend" Icon="@Icons.Material.Filled.Repeat" BadgeData="@(_details.Recurring.Count > 0 ? _details.Recurring.Count : null)" BadgeColor="Color.Primary">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2 mt-2">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Werden automatisch zum Fälligkeitsdatum als Ausgabe angelegt.</MudText>
                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Disabled="_details.IsFromCache"
                           OnClick="() => OpenExpense(null)">Neu</MudButton>
            </MudStack>
            @if (_details.Recurring.Count == 0)
            {
                <EmptyState Icon="@Icons.Material.Outlined.EventRepeat" Title="Keine wiederkehrenden Ausgaben"
                            Description="Beim Anlegen einer Ausgabe „Wiederholen“ aktivieren – ideal für Miete, Strom oder Abos." />
            }
            else
            {
                <MudPaper Elevation="0" Outlined="true">
                    @foreach (var recurring in _details.Recurring)
                    {
                        <div class="split-row">
                            <MudIcon Icon="@Money.CategoryIcon(recurring.Category)" Color="@(recurring.Active ? Color.Primary : Color.Default)" />
                            <div class="split-row-main">
                                <MudText Typo="Typo.body1" Class="text-truncate">@recurring.Title</MudText>
                                <MudText Class="mud-text-secondary" Typo="Typo.caption">
                                    @RepeatInterval.Label(recurring.RepeatInterval) · @_details.MemberName(recurring.PaidBy) zahlt ·
                                    @(recurring.Active ? $"nächste am {recurring.NextDate:dd.MM.yyyy}" : "pausiert")
                                </MudText>
                            </div>
                            <MoneyText Amount="recurring.Amount" Currency="@currency" Colored="false" />
                            <MudTooltip Text="@(recurring.Active ? "Pausieren" : "Fortsetzen")">
                                <MudIconButton Icon="@(recurring.Active ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)" Size="Size.Small"
                                               Disabled="_details.IsFromCache" OnClick="() => ToggleRecurring(recurring)" />
                            </MudTooltip>
                            @if (_details.CanDelete(recurring.CreatedBy))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="Löschen"
                                               Disabled="_details.IsFromCache" OnClick="() => DeleteRecurring(recurring)" />
                            }
                        </div>
                    }
                </MudPaper>
            }
        </MudTabPanel>

        @* ---------------- Statistik ---------------- *@
        <MudTabPanel Text="Statistik" Icon="@Icons.Material.Filled.BarChart">
            <GroupStatistics Details="_details" />
        </MudTabPanel>

        @* ---------------- Mitglieder ---------------- *@
        <MudTabPanel Text="Mitglieder" Icon="@Icons.Material.Filled.People">
            <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="mb-2 mt-2">
                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Link" Color="Color.Primary" Disabled="_details.IsFromCache" OnClick="Invite">Einladungslink</MudButton>
                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" Disabled="_details.IsFromCache" OnClick="AddMember">Hinzufügen</MudButton>
            </MudStack>
            <MudPaper Elevation="0" Outlined="true">
                @foreach (var member in _details.Members)
                {
                    var isMe = member.UserId is not null && member.UserId == AuthService.CurrentUser?.Id;
                    var isAdmin = member.UserId is not null && member.UserId == _details.Group.CreatedBy;
                    <div class="split-row">
                        <MudAvatar Size="Size.Medium" Color="@(member.UserId is null ? Color.Default : Color.Primary)">@Money.Initials(member.DisplayName)</MudAvatar>
                        <div class="split-row-main">
                            <MudText Typo="Typo.body1" Class="text-truncate">
                                @member.DisplayName
                                @if (isMe)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="ml-1">Du</MudChip>
                                }
                                @if (isAdmin)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined" Class="ml-1">Admin</MudChip>
                                }
                            </MudText>
                            <MudText Class="mud-text-secondary" Typo="Typo.caption">
                                @(member.UserId is null ? "Ohne Split-Konto – kann sich per Einladungslink zuordnen" : "Split-Benutzer")
                            </MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Umbenennen"
                                       Disabled="_details.IsFromCache" OnClick="() => RenameMember(member)" />
                        @if (_details.IsAdmin && !isMe)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Size="Size.Small" aria-label="Mitglied entfernen"
                                           Disabled="_details.IsFromCache" OnClick="() => RemoveMember(member)" />
                        }
                    </div>
                }
            </MudPaper>
            @if (!_details.IsAdmin)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2">Mitglieder entfernen und die Gruppe löschen kann nur der Admin.</MudText>
            }
        </MudTabPanel>
    </MudTabs>

    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Label="Ausgabe" Class="split-fab"
            OnClick="() => OpenExpense(null)" aria-label="Ausgabe hinzufügen" />
}

@code {
    [Parameter] public string GroupId { get; set; } = string.Empty;

    private GroupDetails? _details;
    private bool _loading = true;
    private string? _error;
    private int _tab;
    private string _search = string.Empty;
    private string? _categoryFilter;
    private string? _memberFilter;
    private IAsyncDisposable? _realtime;

    private GroupMemberDto? Me => _details?.Me;

    private decimal MyBalance => Me is null ? 0 : _details!.Balances.FirstOrDefault(b => b.MemberId == Me.Id)?.Balance ?? 0;

    private bool IsFiltered => !string.IsNullOrWhiteSpace(_search) || _categoryFilter is not null || _memberFilter is not null;

    /// <summary>Ausgaben gefiltert nach Suchtext, Kategorie und beteiligtem Mitglied (Zahler oder Anteil).</summary>
    private IEnumerable<ExpenseDto> FilteredExpenses => _details!.Expenses.Where(e =>
        (string.IsNullOrWhiteSpace(_search)
         || e.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
         || (e.Note ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase))
        && (_categoryFilter is null || e.Category == _categoryFilter)
        && (_memberFilter is null || e.PaidBy == _memberFilter
            || _details.Shares.Any(s => s.ExpenseId == e.Id && s.MemberId == _memberFilter)));

    private decimal? MyShare(ExpenseDto expense)
        => Me is null ? null : _details!.Shares.FirstOrDefault(s => s.ExpenseId == expense.Id && s.MemberId == Me.Id)?.Amount;

    protected override void OnInitialized() => OfflineSync.Changed += OnSyncChanged;

    protected override async Task OnParametersSetAsync()
    {
        // Beim Wechsel zwischen Gruppen über das Menü neu laden
        if (_details?.Group.Id != GroupId)
        {
            _details = null;
            _tab = 0;
            _search = string.Empty;
            _categoryFilter = null;
            _memberFilter = null;
            await Load();
            await SubscribeRealtime();
        }
    }

    private void OnSyncChanged(int synced)
    {
        _ = InvokeAsync(async () =>
        {
            if (synced > 0)
                await Load();
            else
                StateHasChanged();
        });
    }

    private async Task SubscribeRealtime()
    {
        if (_realtime is not null)
            await _realtime.DisposeAsync();

        _realtime = _details is { IsFromCache: false }
            ? await Realtime.SubscribeToGroup(GroupId, () => InvokeAsync(Load))
            : null;
    }

    private async Task Load()
    {
        _loading = true;
        StateHasChanged();
        var result = await GroupService.GetGroupDetails(GroupId);
        if (result.IsSuccess)
        {
            _details = result.Data;
            _error = null;
        }
        else if (_details is null)
        {
            _error = result.ErrorMessage;
        }
        else
        {
            Snackbar.Add($"Aktualisierung fehlgeschlagen: {result.ErrorMessage}", Severity.Error);
        }
        _loading = false;
        StateHasChanged();
    }

    private static DialogOptions WideDialog => new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    /// <summary>Zeigt einen Dialog und lädt bei Erfolg neu. Ein Text als Ergebnis wird als Meldung angezeigt.</summary>
    private async Task ShowAndReload<TDialog>(DialogParameters<TDialog> parameters) where TDialog : ComponentBase
    {
        var dialog = await DialogService.ShowAsync<TDialog>(null, parameters, WideDialog);
        var result = await dialog.Result;
        if (result is not { Canceled: false }) return;

        if (result.Data is string message)
            Snackbar.Add(message, message.StartsWith("Offline") ? Severity.Info : Severity.Success);
        await Load();
    }

    private async Task OpenExpense(ExpenseDto? expense)
    {
        if (_details is null) return;
        await ShowAndReload(new DialogParameters<ExpenseDialog>
        {
            { x => x.Details, _details },
            { x => x.Expense, expense }
        });
    }

    private async Task OpenSettlement(SettlementDto? settlement, TransferSuggestion? suggestion)
    {
        if (_details is null) return;
        await ShowAndReload(new DialogParameters<SettlementDialog>
        {
            { x => x.Details, _details },
            { x => x.Settlement, settlement },
            { x => x.Suggestion, suggestion }
        });
    }

    private async Task Invite()
    {
        if (_details is null) return;
        var parameters = new DialogParameters<InviteDialog> { { x => x.Details, _details } };
        await DialogService.ShowAsync<InviteDialog>(null, parameters);
    }

    private async Task AddMember()
    {
        var parameters = new DialogParameters<MemberDialog> { { x => x.GroupId, GroupId } };
        var dialog = await DialogService.ShowAsync<MemberDialog>(null, parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: GroupMemberDto member })
        {
            Snackbar.Add($"{member.DisplayName} wurde hinzugefügt.", Severity.Success);
            await Load();
        }
    }

    private async Task RenameMember(GroupMemberDto member)
    {
        var parameters = new DialogParameters<TextInputDialog>
        {
            { x => x.Label, "Anzeigename" },
            { x => x.Value, member.DisplayName }
        };
        var dialog = await DialogService.ShowAsync<TextInputDialog>("Mitglied umbenennen", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: string name } || name == member.DisplayName) return;

        var update = await GroupService.RenameMember(member.Id, name);
        if (update.IsSuccess)
            await Load();
        else
            Snackbar.Add(update.ErrorMessage ?? "Umbenennen fehlgeschlagen", Severity.Error);
    }

    private async Task RemoveMember(GroupMemberDto member)
    {
        if (_details is null) return;

        var confirmed = await DialogService.ShowMessageBoxAsync("Mitglied entfernen",
            $"Soll {member.DisplayName} aus der Gruppe entfernt werden?", yesText: "Entfernen", cancelText: "Abbrechen");
        if (confirmed != true) return;

        var result = await GroupService.RemoveMember(_details, member.Id);
        if (result.IsSuccess)
        {
            Snackbar.Add($"{member.DisplayName} wurde entfernt.", Severity.Success);
            await Load();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Entfernen fehlgeschlagen", Severity.Error);
        }
    }

    private async Task ToggleRecurring(RecurringExpenseDto recurring)
    {
        var result = await ExpenseService.SetRecurringActive(recurring, !recurring.Active);
        if (!result.IsSuccess)
            Snackbar.Add(result.ErrorMessage ?? "Fehler", Severity.Error);
        await Load();
