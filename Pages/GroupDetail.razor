    private async Task DeleteRecurring(RecurringExpenseDto recurring)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Wiederkehrende Ausgabe löschen",
            $"„{recurring.Title}“ wird künftig nicht mehr angelegt. Bereits erzeugte Ausgaben bleiben erhalten.",
            yesText: "Löschen", cancelText: "Abbrechen");
        if (confirmed != true) return;

        var result = await ExpenseService.DeleteRecurring(recurring.Id);
        if (!result.IsSuccess)
